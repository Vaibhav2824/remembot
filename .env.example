# Copy to .env and fill in the two keys. Everything else has a working default.

# --- Required ---------------------------------------------------------------
# Primary model: Groq (free tier works): https://console.groq.com/keys
LLM_API_KEY=
# Web search key (the agent's one tool): https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- Models -----------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint works. gpt-oss-120b on Groq gives the first
# word in about 1.5 s (search included) and is free on Groq's free tier (8k tokens a minute).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_REASONING_EFFORT=low
# Optional fallback, used at once when the primary is rate-limited or down: OpenAI gpt-6-luna
# ($0.10 in / $0.50 out per 1M tokens; the fast tier doubles that for about 2x speed).
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://api.openai.com/v1
FALLBACK_LLM_MODEL=gpt-6-luna
# gpt-6-luna calls tools over Chat Completions only at "none".
FALLBACK_LLM_REASONING_EFFORT=none
FALLBACK_LLM_SERVICE_TIER=fast
# Search the message itself while memory is recalled, saving a model round trip. 0 turns it off.
PRE_SEARCH=1

# Spend caps. Unset = no cap.
MAX_TURNS_PER_DAY=
MAX_TURNS_PER_USER_PER_DAY=50

# Lets a request carry its own clock ({"now": "2026-11-03T10:00:00Z"}) so a dated
# conversation can be replayed. Leave off on a public deployment.
ALLOW_TIME_TRAVEL=1

PORT=3000
DB_PATH=remembot.db
