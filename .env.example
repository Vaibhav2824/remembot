# Copy to .env and fill in the two keys. Everything else has a working default.

# --- Required ---------------------------------------------------------------
# OpenAI key: https://platform.openai.com/api-keys
LLM_API_KEY=
# Web search key (the agent's one tool): https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- Optional ---------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint works (OpenAI, Groq, OpenRouter, Gemini...).
# gpt-6-luna is OpenAI's cheapest model ($0.10 in / $0.50 out per 1M tokens): about $0.006
# for the heaviest turn (6 searches, 4 model calls), so 25 turns cost roughly $0.15.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
# gpt-6-luna calls tools over Chat Completions only at "none". Leave empty to omit the field.
LLM_REASONING_EFFORT=none

# Spend caps. Unset = no cap.
MAX_TURNS_PER_DAY=
MAX_TURNS_PER_USER_PER_DAY=50

# Lets a request carry its own clock ({"now": "2026-11-03T10:00:00Z"}) so a dated
# conversation can be replayed. Leave off on a public deployment.
ALLOW_TIME_TRAVEL=1

PORT=3000
DB_PATH=remembot.db
