# Copy to .env and fill in the two keys. Everything else has a working default.

# --- Required ---------------------------------------------------------------
# Model key. Groq by default: https://console.groq.com/keys
LLM_API_KEY=
# Web search key (the agent's one tool): https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# --- Optional ---------------------------------------------------------------
# Any OpenAI-compatible chat completions endpoint works (Groq, OpenAI, OpenRouter, Gemini...).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Sent only if set. "low" keeps reasoning models fast. Clear it for models that reject it.
LLM_REASONING_EFFORT=low

# Lets a request carry its own clock ({"now": "2026-11-03T10:00:00Z"}) so a dated
# conversation can be replayed. Leave off on a public deployment.
ALLOW_TIME_TRAVEL=1

PORT=3000
DB_PATH=remembot.db
